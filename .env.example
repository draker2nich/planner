# furnitech — переменные окружения.
# Локально: скопируйте в .env и запустите  node --env-file=.env server/index.js
# На Vercel: Settings → Environment Variables (файл .env туда не попадает и в git не коммитится).
# Всё необязательно, кроме отмеченного «нужно на боевом сервере». Пустое значение = значение по умолчанию.

# ───────── Сервер ─────────
PORT=8080
# HOST=127.0.0.1            # слушать только локальный адрес, когда снаружи стоит обратный прокси
# DATA_DIR=./data           # база SQLite, загруженные файлы, письма в файл (локальный режим)
# Адрес сайта для ссылок в письмах и возврата после входа через Google/Яндекс. Нужно на боевом сервере.
# PUBLIC_URL=https://example.com
# За обратным прокси — откуда брать адрес клиента для лимитов (см. комментарий в server/index.js):
#   1          последний адрес в X-Forwarded-For (Caddy; nginx с proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for)
#   x-real-ip  заголовок X-Real-IP (nginx с proxy_set_header X-Real-IP $remote_addr)
# TRUST_PROXY=1
# Политика безопасности содержимого: по умолчанию только отчёт в консоль браузера; 1 — блокировать нарушения.
# CSP_ENFORCE=1
# NODE_ENV=production       # на боевом сервере: письма не пишутся в файл

# ───────── База и файлы ─────────
# Не заданы — SQLite и папка uploads в DATA_DIR. Заданы — Neon Postgres и Vercel Blob (нужен npm install).
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# BLOB_READ_WRITE_TOKEN=

# ───────── Администратор ─────────
# Нужно на боевом сервере. Пароль — длинный случайный (от 12 символов): от него зависит доступ ко всем данным.
# Изменили значение и перезапустили — пароль администратора переписывается из переменной.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# ADMIN_SESSION_DAYS=7      # срок сеанса администратора, суток (у пользователей — 30)
# AUTH_SECRET=              # соль для меток адресов в лимитах; не задана — создаётся сама и хранится в базе

# ───────── Регистрация и почта ─────────
# REGISTRATION_ENABLED=0    # закрыть регистрацию
# REQUIRE_VERIFIED_EMAIL=1  # не сохранять проекты в аккаунт без подтверждённой почты
# CONTACT_EMAIL=            # адрес на страницах сайта и получатель писем о новых заявках
# Отправка писем: Resend или Postmark (нужен MAIL_FROM с подтверждённого домена). Без ключа локально письма пишутся в DATA_DIR/outbox.
# MAIL_FROM=furnitech <no-reply@example.com>
# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=
# MAIL_MODE=off             # выключить письма совсем

# ───────── Вход через Google и Яндекс ─────────
# Адрес возврата в кабинете провайдера: <PUBLIC_URL>/api/auth/oauth/google/callback (или …/yandex/callback)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=

# ───────── ИИ‑дизайнер ─────────
# AI_MOCK=1                 # заглушка без обращения к модели (для разработки и тестов)
# AI_PROVIDER=anthropic     # anthropic | openai
# AI_API_KEY=
# AI_MODEL=                 # по умолчанию у anthropic — claude-opus-5-5
# AI_MODEL_TASTE=           # модель отдельного шага: TASTE, CONCEPT, LAYOUT
# AI_BASE_URL=              # адрес API, если отличается от стандартного
# AI_TIMEOUT_MS=45000
# AI_RETRIES=2
# Лимиты расхода. Одна генерация — несколько платных обращений к модели: разбор пожеланий, концепция, расстановка каждого варианта (до 10).
# AI_DAILY_RUNS=10          # генераций на пользователя в сутки
# AI_DAILY_CALLS=2000       # обращений к модели в сутки на всю платформу
# AI_MONTHLY_CALLS=         # обращений за 30 суток на всю платформу (страховка от счёта провайдера); не задано — без предела
# Цены для сводки расходов в админ‑панели (за миллион токенов):
# AI_PRICE_IN=
# AI_PRICE_OUT=
# AI_PRICES={"claude-opus-5-5":{"in":5,"out":25}}
# AI_PRICE_CURRENCY=USD

# ───────── Каталог ─────────
# SEED_DEMO=0               # не заполнять пустой каталог демо‑товарами
